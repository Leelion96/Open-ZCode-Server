NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://localhost:8443
# Docker Compose 用 db hostname；在宿主机开发时改为已部署数据库的地址。
DATABASE_URL=postgresql://open_zcode:change-this-development-password@db:5432/open_zcode
POSTGRES_USER=open_zcode
POSTGRES_DB=open_zcode
POSTGRES_PASSWORD=change-this-development-password
OPENAPI_ENABLED=true
CORS_ORIGINS=
LOG_LEVEL=info
BODY_LIMIT_BYTES=1048576
API_PORT=3000
HTTPS_PORT=8443
TLS_HOST=localhost
# 部署实例标识，与产品显示名无关；已有实例保持原值以复用原数据库volume。
COMPOSE_PROJECT_NAME=open-zcode-server
