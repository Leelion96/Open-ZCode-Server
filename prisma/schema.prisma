generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// 内部部署元数据；用户、会话与权益模型在对应 spec 确定后再添加。
model ServerMetadata {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("server_metadata")
}

model AnnouncementReceipt {
  deviceMid  String   @map("device_mid") @db.Uuid
  campaignId String   @map("campaign_id") @db.VarChar(128)
  actionType String   @map("action_type") @db.VarChar(7)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([deviceMid, campaignId])
  @@map("announcement_receipts")
}
